# Copy this file to .env and fill in only the providers you use.

# Gemini-based skills: audio-transcriber, create-cover-illustration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-pro-image-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-image
GEMINI_TIMEOUT=120

# create-cover-illustration optional proxy fallback
GEMINI_PROXY_ENDPOINT=

# publish-assets
PUBLISH_ASSETS_PROVIDER=r2
R2_ACCESS_KEY=your_access_key_here
R2_SECRET_KEY=your_secret_key_here
R2_BUCKET=your_bucket_name_here
R2_ENDPOINT=your_r2_endpoint_here
