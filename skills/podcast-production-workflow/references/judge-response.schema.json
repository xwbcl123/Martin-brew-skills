{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Podcast Smart Edit Judge Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "judge_role", "verdict", "confidence", "reason", "quoted_evidence", "candidate_packet_sha256", "prompt_sha256", "model_id", "cli_version", "raw_response_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{4,80}$"},
    "judge_role": {"enum": ["text", "audio"]},
    "verdict": {"enum": ["cut", "keep", "abstain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "quoted_evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
    "candidate_packet_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "model_id": {"type": "string", "minLength": 3},
    "cli_version": {"type": "string", "minLength": 1},
    "raw_response_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
