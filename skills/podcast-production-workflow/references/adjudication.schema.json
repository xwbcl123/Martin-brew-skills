{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Podcast Dual-Judge Adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "stage", "status", "run_key", "policy_sha256", "stability_report_sha256", "candidate_bundle_sha256", "decisions", "summary", "publish_authorized"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string"},
    "stage": {"const": "S06-adjudicate"},
    "status": {"enum": ["succeeded", "review_required", "blocked"]},
    "run_key": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "stability_report_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "summary": {"type": "object"},
    "publish_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sample", "end_sample"],
      "properties": {"start_sample": {"type": "integer", "minimum": 0}, "end_sample": {"type": "integer", "minimum": 1}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "category", "core_interval", "text_verdict", "audio_verdict", "decision", "reason_codes"],
      "properties": {
        "candidate_id": {"type": "string"},
        "category": {"type": "string"},
        "core_interval": {"$ref": "#/$defs/interval"},
        "text_verdict": {"enum": ["cut", "keep", "abstain", "missing", "drift"]},
        "audio_verdict": {"enum": ["cut", "keep", "abstain", "missing", "drift"]},
        "decision": {"enum": ["auto_cut_eligible", "keep", "review_required"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
