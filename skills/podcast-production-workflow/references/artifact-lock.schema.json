{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-os.local/podcast/artifact-lock.schema.json",
  "title": "Podcast artifact identity lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "dag_id", "dag_sha256", "artifacts", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^[0-9]{8}_[a-z0-9-]+$"},
    "dag_id": {"type": "string", "minLength": 1},
    "dag_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
