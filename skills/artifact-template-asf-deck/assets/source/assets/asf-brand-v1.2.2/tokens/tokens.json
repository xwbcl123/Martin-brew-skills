{
  "name": "ASF Brand Tokens",
  "version": "1.2.2",
  "ssot": "tokens.css",
  "tokens": {
    "--asf-ink-900": "#0B0F19",
    "--asf-ink-800": "#16212C",
    "--asf-ink-700": "#263241",
    "--asf-paper": "#F4F1E9",
    "--asf-surface": "#FFFFFF",
    "--asf-rule": "#D7D2C7",
    "--asf-muted": "#5F6971",
    "--asf-signal-600": "#137B70",
    "--asf-signal-400": "#29DDDA",
    "--asf-signal-300": "#62D7BF",
    "--asf-signal-200": "#16FFBB",
    "--asf-blue": "#37A7E7",
    "--asf-amber": "#F1C84B",
    "--asf-on-ink": "#EEF5F2",
    "--asf-on-ink-muted": "#B9CBC0",
    "--asf-on-mint": "#06120F",
    "--asf-wordmark-on-ink": "#F0FCFF",
    "--asf-font-display": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Songti SC\", serif",
    "--asf-font-body": "\"Avenir Next\", Avenir, \"Segoe UI\", Helvetica, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "--asf-font-mono": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "--asf-font-brand": "\"Spline Sans\", \"Avenir Next\", \"PingFang SC\", sans-serif",
    "--asf-font-condensed": "\"Barlow Condensed\", \"Arial Narrow\", sans-serif",
    "--asf-text-meta": "11px",
    "--asf-text-xs": "12px",
    "--asf-text-caption": "13px",
    "--asf-text-sm": "14px",
    "--asf-text-ui": "15px",
    "--asf-text-md": "16px",
    "--asf-text-body": "17px",
    "--asf-text-lg": "18px",
    "--asf-text-xl": "20px",
    "--asf-text-2xl": "24px",
    "--asf-text-h3": "28px",
    "--asf-text-3xl": "32px",
    "--asf-text-4xl": "48px",
    "--asf-text-display": "clamp(44px, 6.3vw, 94px)",
    "--asf-leading-body": "1.62",
    "--asf-leading-tight": "1.05",
    "--asf-tracking-meta": "0.08em",
    "--asf-measure": "67ch",
    "--asf-space-1": "4px",
    "--asf-space-2": "8px",
    "--asf-space-3": "12px",
    "--asf-space-4": "16px",
    "--asf-space-6": "24px",
    "--asf-space-8": "32px",
    "--asf-space-12": "48px",
    "--asf-space-16": "64px",
    "--asf-space-24": "96px",
    "--asf-rule-width": "1px",
    "--asf-focus-width": "3px",
    "--asf-target-min": "44px",
    "--asf-shell": "min(1220px, calc(100% - 64px))",
    "--asf-radius": "0px",
    "--asf-radius-control": "2px",
    "--asf-radius-media": "4px",
    "--asf-radius-round": "50%",
    "--asf-chamfer-frame": "polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px)",
    "--asf-paper-edge": "color-mix(in oklch, var(--asf-rule) 70%, var(--asf-paper))",
    "--asf-shadow-stack-sm": "4px 4px 0 var(--asf-paper-edge)",
    "--asf-shadow-stack-md": "7px 7px 0 var(--asf-paper-edge)",
    "--asf-shadow-stack-lg": "17px 17px 0 var(--asf-rule)",
    "--asf-shadow-stack-ink": "7px 7px 0 color-mix(in oklch, var(--asf-on-ink) 13%, var(--asf-ink-800))",
    "--asf-shadow-marker": "inset 3px 0 0 var(--asf-accent)",
    "--asf-ease": "cubic-bezier(.2, .65, .3, 1)",
    "--asf-ease-reveal": "cubic-bezier(.16, 1, .3, 1)",
    "--asf-duration": "180ms",
    "--asf-duration-step": "320ms",
    "--asf-duration-reveal": "800ms",
    "--asf-move-max": "2px",
    "--asf-icon-size": "24px",
    "--asf-icon-size-sm": "18px",
    "--asf-icon-stroke": "1.7",
    "--asf-bp-nav": "900px",
    "--asf-bp-mobile": "620px",
    "--asf-bp-small": "360px",
    "--asf-z-raised": "1",
    "--asf-z-sticky": "20",
    "--asf-z-progress": "30",
    "--asf-z-overlay": "100",
    "--asf-positive-paper": "#137B70",
    "--asf-positive-ink": "#16FFBB",
    "--asf-info-paper": "#1F6FA8",
    "--asf-info-ink": "#37A7E7",
    "--asf-warning-paper": "#8A6100",
    "--asf-warning-ink": "#F1C84B",
    "--asf-critical-paper": "#B3261E",
    "--asf-critical-ink": "#FF8A7A"
  },
  "registers": {
    "paper": {
      "--asf-accent": "var(--asf-signal-600)",
      "--asf-kicker": "var(--asf-signal-600)",
      "--asf-focus": "var(--asf-signal-600)",
      "--asf-border": "var(--asf-rule)",
      "--asf-text-muted": "var(--asf-muted)",
      "--asf-raised": "var(--asf-surface)",
      "--asf-positive": "var(--asf-positive-paper)",
      "--asf-info": "var(--asf-info-paper)",
      "--asf-warning": "var(--asf-warning-paper)",
      "--asf-critical": "var(--asf-critical-paper)"
    },
    "ink": {
      "--asf-accent": "var(--asf-signal-200)",
      "--asf-kicker": "var(--asf-signal-300)",
      "--asf-focus": "var(--asf-signal-300)",
      "--asf-border": "var(--asf-ink-700)",
      "--asf-text-muted": "var(--asf-on-ink-muted)",
      "--asf-raised": "var(--asf-ink-800)",
      "--asf-positive": "var(--asf-positive-ink)",
      "--asf-info": "var(--asf-info-ink)",
      "--asf-warning": "var(--asf-warning-ink)",
      "--asf-critical": "var(--asf-critical-ink)"
    }
  },
  "reducedMotion": {
    "--asf-duration": "0.01ms",
    "--asf-duration-step": "0.01ms",
    "--asf-duration-reveal": "0.01ms",
    "--asf-move-max": "0px"
  },
  "fieldNotesAliases": {
    "--bg": "var(--asf-paper)",
    "--surface": "var(--asf-surface)",
    "--fg": "var(--asf-ink-900)",
    "--muted": "var(--asf-muted)",
    "--border": "var(--asf-rule)",
    "--accent": "var(--asf-signal-600)",
    "--deep": "var(--asf-ink-800)",
    "--deep-fg": "var(--asf-on-ink)",
    "--signal-light": "var(--asf-signal-300)"
  },
  "fonts": {
    "Spline Sans 700": "fonts/SplineSans-Bold.woff2 (OFL-1.1)"
  },
  "icons": "icons/asf-icons.svg"
}
