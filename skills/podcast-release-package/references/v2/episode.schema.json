{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Podcast episode v2",
  "type": "object",
  "required": [
    "contract_version",
    "episode_key",
    "package_revision",
    "source_kind",
    "review_mode",
    "show_id",
    "profile_ref",
    "sources",
    "artifacts",
    "reviews",
    "rights"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "episode_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "package_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_kind": {
      "enum": [
        "raw_recording",
        "imported_finished",
        "generated_finished"
      ]
    },
    "review_mode": {
      "const": "delegated_release"
    },
    "show_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "profile_ref": {
      "const": "podcast_mp3"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "parents": {
            "type": "array"
          }
        }
      }
    },
    "provider_metadata": {
      "type": "object",
      "required": ["author", "explicit", "type", "season", "number", "image_url"],
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string", "minLength": 1},
        "explicit": {"type": "boolean"},
        "type": {"type": "string", "minLength": 1},
        "season": {"type": "integer", "minimum": 0},
        "number": {"type": "integer", "minimum": 1},
        "image_url": {"type": "string", "format": "uri"},
        "explicit_evidence": {
          "type": "object",
          "required": ["kind", "artifact_role", "cue_id", "cue_text"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "user_supplied_srt_cue"},
            "artifact_role": {"const": "supplied_srt_source"},
            "cue_id": {"type": "integer", "minimum": 0},
            "cue_text": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"explicit": {"const": true}}, "required": ["explicit"]},
          "then": {"required": ["explicit_evidence"]}
        },
        {
          "if": {"properties": {"explicit": {"const": false}}, "required": ["explicit"]},
          "then": {"not": {"required": ["explicit_evidence"]}}
        }
      ]
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights": {
      "type": "object"
    },
    "publication_transcript": {
      "type": "object",
      "required": [
        "version",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "const": "reading_transcript"
        }
      }
    }
  }
}
