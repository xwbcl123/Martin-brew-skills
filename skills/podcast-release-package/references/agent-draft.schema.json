{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local agent draft evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_mode", "episode_key", "revision", "producer_id", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "agent-draft-v1"},
    "review_mode": {"const": "agent_draft"},
    "episode_key": {"type": "string", "pattern": "^[0-9]{8}_[a-z0-9][a-z0-9-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object", "additionalProperties": false, "required": ["review_audio"],
      "properties": {
        "review_audio": {"$ref": "#/$defs/artifact"},
        "transcript": {"$ref": "#/$defs/artifact"},
        "notes": {"$ref": "#/$defs/artifact"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "review_mode", "episode_key", "manifest_sha256", "authorized_by", "source_ref", "actions"],
      "properties": {
        "kind": {"const": "user_local_draft_authorization"},
        "review_mode": {"const": "agent_draft"},
        "episode_key": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha"},
        "authorized_by": {"const": "user"},
        "source_ref": {"type": "string", "minLength": 1},
        "actions": {"const": ["validate_local", "preview_local"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reviewer_id", "producer_id", "episode_key", "manifest_sha256", "artifact_hashes", "verdict", "coverage", "evidence"],
      "properties": {
        "kind": {"const": "independent_agent_draft_review"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "producer_id": {"type": "string", "minLength": 1},
        "episode_key": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha"},
        "artifact_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha"}},
        "verdict": {"const": "draft_acceptable"},
        "coverage": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
